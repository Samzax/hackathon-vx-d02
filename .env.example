# Copie para .env e preencha só as chaves que tiver. Nenhuma é obrigatória:
# o sistema usa o primeiro provedor configurado de cada tarefa (ver docs/ARQUITETURA.md).
# O .env nunca vai para o GitHub (.gitignore).

# OpenCode Go: uma chave para vários modelos (Haiku 5.5, DeepSeek V4.1 Flash...)
# Chave em https://opencode.ai/auth
OPENCODE_API_KEY=

# Anthropic direto: Claude Haiku 5.5
# Chave em https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# DeepSeek direto (alternativa barata)
# Chave em https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Amazon Bedrock (no evento, com a conta da organização). Não coloque chaves AWS aqui:
# use o perfil temporário que a organização fornecer. MITRA_BEDROCK=1 liga o provedor
# (ver mitra/modelos.toml para os IDs dos modelos).
AWS_PROFILE=
AWS_REGION=us-east-1
MITRA_BEDROCK=

# OCR de PDF escaneado: textract liga o Amazon Textract (mesmo perfil AWS acima).
MITRA_OCR=

# Guardar o PDF original de cada evidência registrada: sem valor, fica em data/evidencias/;
# com o nome de um bucket S3 (acesso público bloqueado), vai para o S3.
MITRA_S3_BUCKET=

# Link público com IA ao vivo: teto de gasto por dia (US$, dia UTC) e análises pagas por visita.
# Vazio = sem teto (uso local).
MITRA_TETO_DIA_USD=
MITRA_LIMITE_SESSAO=
