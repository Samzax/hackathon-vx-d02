{
  "name": "regulaia-front",
  "version": "1.0.0",
  "private": true,
  "description": "Mitra: o front da torre de controle regulatória (Next.js exportado, fala só com a API)",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "tipos": "openapi-typescript ../api/openapi.json -o src/lib/api-tipos.ts",
    "tipos:conferir": "openapi-typescript ../api/openapi.json -o src/lib/api-tipos.ts --check",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tanstack/react-query": "^5.107.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.70.0",
    "next": "16.4.5",
    "openapi-fetch": "^0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.5",
    "jsdom": "^31.0.0",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  }
}
